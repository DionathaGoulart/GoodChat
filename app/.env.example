# GoodChat frontend — copy to .env for local overrides (defaults work as-is).

# Base URL of the Worker API. Local backend always runs on port 8000.
VITE_API_URL=http://localhost:8000

# Base URL the app reads media from (message media_key is appended to it).
# The bucket is private: reads go through the Worker's authenticated proxy,
# so this is the Worker origin + /api/media (empty host in production, where
# the Worker also serves the SPA).
VITE_MEDIA_URL=http://localhost:8000/api/media
