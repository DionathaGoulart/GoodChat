# GoodChat frontend — copy to .env for local overrides (defaults work as-is).

# Base URL of the Worker API. Local backend always runs on port 8000.
VITE_API_URL=http://localhost:8000

# Public base URL where media objects are served (message media_key is
# appended to it). Must match the worker's B2_PUBLIC_BASE_URL. The default is
# the local fake-B2 stub (`npm run media:dev` in /worker); in production this
# is the Cloudflare-fronted B2 domain, e.g.
# https://media.example.com/file/goodchat-media
VITE_MEDIA_URL=http://localhost:9000/goodchat-media
