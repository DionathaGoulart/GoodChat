# Production build config (picked up automatically by `npm run build`).
# No secrets here — commitable.

# Empty = same origin: the Worker serves this SPA and the API together
# (wrangler.jsonc "assets"). See tutorial.md §2.
VITE_API_URL=

# Media reads: same origin as the API. The B2 bucket is private, so the
# Worker signs and streams every object at /api/media/<key> (session-checked,
# edge-cached, free B2 → Cloudflare egress). No bucket URL belongs here.
VITE_MEDIA_URL=/api/media
