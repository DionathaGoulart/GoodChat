# Production build config (picked up automatically by `npm run build`).
# No secrets here — commitable.

# Empty = same origin: the Worker serves this SPA and the API together
# (wrangler.jsonc "assets"). See tutorial.md §2.
VITE_API_URL=

# Public base URL where media objects are served. Must match the worker's
# B2_PUBLIC_BASE_URL. EDIT after creating the real bucket (tutorial.md §4) —
# this placeholder follows the B2 friendly-URL shape.
VITE_MEDIA_URL=https://f004.backblazeb2.com/file/goodchat-media
