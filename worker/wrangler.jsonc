{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goodchat-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // Custom domain on the dionatha.com.br zone (wrangler manages the DNS
  // record). One canonical origin on purpose: the session cookie is scoped
  // per origin, so a second URL would mean a second, confusing login.
  "routes": [{ "pattern": "goodchat.dionatha.com.br", "custom_domain": true }],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "ConversationAgent",
        "class_name": "ConversationAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ConversationAgent"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goodchat",
      "database_id": "da0b3881-23eb-4c2d-816b-208817c26c27"
    }
  ],
  // SPA served by the Worker itself (same origin as the API — the session
  // cookie is SameSite=Strict, so a separate frontend origin would never send
  // it). Every request runs the Worker script first: /api/* is routed, and
  // everything else is fetched from the ASSETS binding and re-emitted with the
  // security headers (an index.html delivered straight from the asset server
  // would carry no CSP). Build the app before deploying (deploy:full).
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Maintenance sweep (src/lib/cleanup.ts): expired sessions, stale rate-limit
  // counters, orphaned uploads, and media retention when it is enabled.
  "triggers": {
    "crons": ["17 * * * *"]
  },
  // Non-secret production config. Secrets (B2 keys, VAPID private key) go in
  // via `wrangler secret put`. These do NOT apply to local dev — .dev.vars does.
  "vars": {
    // The one origin this Worker serves from (see `routes` above). Deleting a
    // media object has to evict its edge-cached copy, and the two places that
    // delete without an incoming Request — the Durable Object's retention alarm
    // and the cron backstop — have no origin to build that cache key from
    // (src/lib/mediaGc.ts). Must match the deployed hostname exactly.
    "PUBLIC_ORIGIN": "https://goodchat.dionatha.com.br",
    "B2_BUCKET_NAME": "goodchat-media",
    "B2_S3_ENDPOINT": "https://s3.us-east-005.backblazeb2.com",
    "VAPID_PUBLIC_KEY": "BJGYYnihl2IiXX0tg_cyQemfkNKKEI5IxgX15d0QrH6dYcyJEXVTS3bVeiG_8ibELE0SoShEFk3XRy0dfcwUcnk",
    "VAPID_SUBJECT": "mailto:dionatha.work@gmail.com",
    // Extra browser origins allowed to call the API with credentials. Empty in
    // production: the SPA is same-origin, so nothing else needs access. The
    // same list decides the WebSocket handshake (src/routes/ws.ts) and the CSRF
    // check on POST/PATCH/PUT/DELETE (src/index.ts).
    "ALLOWED_ORIGINS": "",
    // Extra push-service hosts, comma-separated, matched as domain suffixes and
    // *added* to the built-in list (Firefox, Chrome, Safari, Edge —
    // src/lib/push.ts). A stored endpoint is a URL this Worker POSTs to on every
    // message the account receives, so the list is what keeps it a push service
    // rather than anywhere on the internet. Empty in production; only a browser
    // the defaults miss needs anything here.
    "PUSH_ENDPOINT_HOSTS": "",
    // Refuse a message that arrives without an encryption envelope.
    //
    // On, because an instance that advertises end-to-end encryption and quietly
    // accepts plaintext is telling two different stories: `seal` returns null
    // whenever the peer has no key in the directory, and before this flag the
    // message went out in the clear with nothing but a banner about it.
    //
    // The cost is real and worth stating: an account with no registered device
    // cannot be written to at all. Its sends are refused with
    // `encryption_required` until it opens the app somewhere that can keep an
    // identity — which a private window cannot, because it has no IndexedDB.
    // Before deploying a change to this value, check who is not ready:
    //
    //   wrangler d1 execute goodchat --remote --command \
    //     "SELECT u.username FROM users u
    //        LEFT JOIN devices d ON d.user_id = u.id
    //       WHERE d.id IS NULL"
    //
    // Nothing has to be migrated either way — retention deletes every plaintext
    // message within seven days on its own, so the instance ends up fully
    // encrypted a week after the deploy regardless. This flag is what stops it
    // going back.
    "E2EE_REQUIRED": "true",
    // Delete claimed media older than this many days. "0" = keep forever.
    // Turning it on makes old bubbles render the "mídia expirada" placeholder.
    "MEDIA_RETENTION_DAYS": "0",
    // Guest accounts (POST /api/auth/temp, lib/accounts.ts). "false" closes the
    // instance back down: no public way in, invite-only again.
    "TEMP_ACCOUNTS_ENABLED": "true",
    // How long a guest account lives before it and its data are deleted.
    // Also the ceiling, not the rule: a guest has no password, so signing out
    // deletes the account on the spot (routes/auth.ts). This is what catches
    // the tab that was simply closed.
    "TEMP_ACCOUNT_TTL_HOURS": "3",
    // Ceiling on guest accounts alive at once, and how many one address may
    // create per hour. Both exist because the endpoint is unauthenticated.
    "TEMP_ACCOUNTS_MAX": "100",
    "TEMP_ACCOUNTS_PER_IP_HOUR": "3",
    // Objects with no row in media_objects. Only "allow" opens the pre-0003
    // rule (any session + an unguessable key); anything else — including unset
    // — refuses them. `media/` and `avatars/` keys are refused regardless: both
    // prefixes always have an index row, so a missing one means the object was
    // deleted, not that it is old (src/routes/media.ts).
    //
    // Before deploying with "deny": run POST /api/admin/media/reindex once and
    // confirm indexed_media_bytes matches bucket_bytes in the owner overview.
    "MEDIA_LEGACY_READS": "deny",
    // Storage ceilings the owner console divides usage by (used / total). They
    // are display only — nothing rejects a write when they are reached. The
    // defaults are the free tiers: 5 GB of Durable Object SQLite, 10 GB of B2.
    // "0" hides the total and shows the plain usage again.
    "DO_STORAGE_LIMIT_GB": "5",
    "B2_STORAGE_LIMIT_GB": "10"
  },
  "observability": {
    "enabled": true
  }
}
