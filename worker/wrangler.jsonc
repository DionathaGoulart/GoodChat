{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goodchat-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "ConversationAgent",
        "class_name": "ConversationAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ConversationAgent"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goodchat",
      // Placeholder id — local dev ignores it; replace with the real id from
      // `wrangler d1 create goodchat` before the first deploy (see .env.example).
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // SPA served by the Worker itself (same origin as the API — the session
  // cookie is SameSite=Strict, so a separate frontend origin would never send
  // it). /api/* always reaches the Worker script, everything else serves the
  // Vite build with SPA fallback. Build the app before deploying (deploy:full).
  "assets": {
    "directory": "../app/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
