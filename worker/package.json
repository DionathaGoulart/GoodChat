{
  "name": "goodchat-worker",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../app/dist && wrangler dev --port 8000",
    "deploy": "wrangler deploy",
    "deploy:full": "cd ../app && npm run build && cd ../worker && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply goodchat --local",
    "db:seed": "node scripts/seed.ts",
    "user:create": "node scripts/create-user.ts",
    "user:role": "node scripts/set-role.ts",
    "smoke:phase3": "node scripts/smoke-phase3.ts",
    "smoke:phase4": "node scripts/smoke-phase4.ts",
    "smoke:phase6": "node scripts/smoke-phase6.ts",
    "smoke:phase7": "node scripts/smoke-phase7.ts",
    "smoke:phase8": "node scripts/smoke-phase8.ts",
    "smoke:phase9": "node scripts/smoke-phase9.ts",
    "smoke:phase10": "node scripts/smoke-phase10.ts",
    "smoke:phase11": "node scripts/smoke-phase11.ts",
    "smoke:phase12": "node scripts/smoke-phase12.ts",
    "smoke:phase13": "node scripts/smoke-phase13.ts",
    "smoke:phase14": "node scripts/smoke-phase14.ts",
    "smoke:phase15": "node scripts/smoke-phase15.ts",
    "smoke:phase16": "node --import ./scripts/ts-extensions.mjs scripts/smoke-phase16.ts",
    "smoke:phase17": "node scripts/smoke-phase17.ts",
    "smoke:phase18": "node scripts/smoke-phase18.ts",
    "vapid:generate": "node scripts/vapid-generate.ts",
    "media:dev": "node scripts/media-dev-server.ts",
    "stickers:publish": "node scripts/publish-stickers.ts"
  },
  "dependencies": {
    "@mmmike/web-push": "^1.3.0",
    "@pushforge/builder": "^2.0.5",
    "agents": "^0.20.1",
    "aws4fetch": "^1.0.20",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.123.0",
    "ws": "^8.21.3"
  }
}
