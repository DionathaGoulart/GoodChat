# GoodChat worker — reference of every secret/config the backend will need.
#
# Wrangler does NOT read .env: local secrets go in `worker/.dev.vars`
# (gitignored, same KEY=value format), production secrets via
# `wrangler secret put <NAME>`.
#
# Non-secret bindings live in wrangler.jsonc:
#   - D1: binding "DB", database_name "goodchat". The committed database_id is a
#     placeholder — local dev ignores it; before the first deploy run
#     `wrangler d1 create goodchat` and paste the real id into wrangler.jsonc.
#   - Durable Object: binding "ConversationAgent" (SQLite-backed, migration v1).

# --- Phase 2 (auth) ---
# No secrets needed: session tokens are random opaque values (no signing key)
# and account creation is CLI-only (`npm run user:create -- <user> <pass>`,
# no admin endpoint). Local DB setup: `npm run db:migrate && npm run db:seed`.

# --- Phase 6 (media / Backblaze B2, S3-compatible API) ---
#
# LOCAL DEV (no B2 account needed): `worker/.dev.vars` ships pointing at the
# fake-B2 stub — run `npm run media:dev` (port 9000) alongside `npm run dev`.
#
# REAL B2 SETUP (production, or dev against the real bucket):
#   1. Create a bucket (PRIVATE):       b2 bucket create goodchat-media allPrivate
#      Nothing is ever fetched from B2 by the browser: the Worker signs every
#      GET and streams it at /api/media/<key> (session-checked, edge-cached,
#      free B2 → Cloudflare egress). A public bucket would leak any key.
#   2. Create an application key scoped to it:
#        b2 key create --bucket goodchat-media goodchat-worker listBuckets,readFiles,writeFiles
#      → keyID goes in B2_KEY_ID, applicationKey in B2_APPLICATION_KEY.
#   3. Browser PUTs need a CORS rule on the bucket naming the S3 operation
#      s3_put — the web UI "all origins" preset only covers downloads:
#        b2 bucket update goodchat-media --cors-rules '[{"corsRuleName":
#          "goodchat-browser-upload","allowedOrigins":["https://your.app"],
#          "allowedOperations":["s3_put"],"allowedHeaders":["*"],
#          "exposeHeaders":["etag"],"maxAgeSeconds":3600}]'
#      Requires a key with writeBuckets (the step-2 key has none) — use the
#      master key. GETs need no rule, they never leave the Worker.
#   4. B2_S3_ENDPOINT is the bucket's S3 endpoint shown in the UI, e.g.
#        https://s3.us-west-004.backblazeb2.com
#   Deploy: `wrangler secret put` for the two keys; bucket name and endpoint
#   can be plain vars in wrangler.jsonc or secrets alike.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_S3_ENDPOINT=

# --- Phase 8 (Web Push / PWA) ---
# VAPID key pair identifies this server to browser push services (RFC 8292).
# Generate once with `npm run vapid:generate`; local values go in .dev.vars
# (the repo's .dev.vars already ships a dev pair), production via
# `wrangler secret put VAPID_PRIVATE_KEY` (public key + subject can be plain
# vars). Rotating the pair kills every existing browser subscription — users
# must opt in again. Subject is a contact for push services (mailto: or URL).
# The app fetches the public key from GET /api/push/vapid-public-key — no
# frontend env needed. Subscriptions live in D1 (migration 0002).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Phase 9 (hardening, retention, owner console) ---
#
# ALLOWED_ORIGINS: extra browser origins allowed to call the API with
# credentials, comma-separated. The Worker's own origin is always allowed, so
# production (single origin) leaves this empty; local dev needs the Vite
# server. Anything not listed gets no Access-Control-Allow-Origin at all.
ALLOWED_ORIGINS=http://localhost:5173

# MEDIA_RETENTION_DAYS: the hourly cron deletes claimed media older than this.
# "0" (default) keeps everything forever — deleting a conversation's photos on
# a timer is a product decision, not a default. Bubbles whose object is gone
# render a "mídia indisponível" placeholder.
MEDIA_RETENTION_DAYS=0

# MEDIA_LEGACY_READS: what to do with objects that have no row in
# media_objects (uploaded before migration 0003). "allow" keeps the pre-0003
# rule — any valid session plus an unguessable key — so existing threads keep
# rendering. Run POST /api/admin/media/reindex once from the owner console,
# confirm indexed_media_bytes matches bucket_bytes in the overview, then set
# this to "deny" so every media read requires conversation membership.
MEDIA_LEGACY_READS=allow

# The owner role is granted in the database, never through an endpoint:
# migration 0003 promotes the `good` account, and
# `npm run user:role -- [--remote] <username> owner` promotes any other.

# --- Phase 7 (stickers) ---
# The curated pack lives in worker/assets/stickers/v1 and must exist in the
# media store under stickers/v1/ (no secrets involved):
#   - local dev:  npm run stickers:publish   (plain PUT to the fake-B2 stub;
#     override the target with MEDIA_PUT_BASE=<url>)
#   - real B2:    the bucket only accepts signed PUTs — publish with the b2
#     CLI, e.g.  b2 sync worker/assets/stickers b2://goodchat-media/stickers
